
APP_NAME=Document Intelligence Platform
APP_ENV=development
DEBUG=true

# SQLite database
DATABASE_URL=sqlite:///./data/indexes/manifest.db

# LLM configuration
LLM_MODE=mock
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=qwen-full
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=120

# Local embedding model
EMBEDDING_MODEL=./models/bge-base-en-v1.5

# Storage paths
PDF_STORAGE_PATH=./data/pdfs
INDEX_STORAGE_PATH=./data/indexes
SUMMARY_STORAGE_PATH=./data/summaries
